<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeRefreshLayout"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".screens.MainActivity">

        <!-- Toolbar with a gradient background and a light theme -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarM"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_bg"
            android:elevation="@dimen/dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:menu="@menu/toolbar_menu"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Finance App"
            app:titleTextColor="@color/white" />

        <!-- Total Balance CardView with padding and margins for better spacing -->
        <androidx.cardview.widget.CardView
            android:id="@+id/totalBalanceCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp8"
            app:cardElevation="@dimen/dp4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbarM">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/dp16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_balance"
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalBalanceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rs"
                    android:textColor="@color/black"
                    android:textSize="@dimen/dp30"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Income and Expense Cards with a horizontal layout and modern design -->
        <LinearLayout
            android:id="@+id/incomeCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp8"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginEnd="@dimen/dp8"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/totalBalanceCard">

            <!-- Income Card with relative layout for proper positioning -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp4"
                android:layout_weight="1"
                app:cardElevation="@dimen/dp4">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/line_around_income"
                    android:padding="@dimen/dp16">

                    <ImageView
                        android:id="@+id/up_arrow"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@string/income_increase"
                        android:src="@drawable/arrow_down"
                        app:tint="@color/green" />

                    <TextView
                        android:id="@+id/textViewIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/up_arrow"
                        android:layout_alignParentStart="true"
                        android:text="@string/total_income"
                        android:textSize="@dimen/sp14"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/totalIncomeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textViewIncome"
                        android:text="@string/rs"
                        android:textColor="@color/green"
                        android:textSize="@dimen/sp20" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Expense Card with a relative layout for proper positioning -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                android:layout_weight="1"
                app:cardElevation="@dimen/dp4">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/line_around_expense"
                    android:padding="@dimen/dp16">

                    <ImageView
                        android:id="@+id/imageViewExpenseArrow"
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@string/expense_increase"
                        android:src="@drawable/baseline_arrow_upward_24"
                        app:tint="@android:color/holo_red_dark" />

                    <TextView
                        android:id="@+id/tvExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/imageViewExpenseArrow"
                        android:layout_alignParentStart="true"
                        android:text="@string/total_expense"
                        android:textSize="@dimen/sp14"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/totalExpenseTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvExpense"
                        android:text="@string/rs"
                        android:textColor="@color/Red"
                        android:textSize="@dimen/sp20" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Recent Transactions Title with margin for proper spacing -->
        <TextView
            android:id="@+id/recentTransactionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp8"
            android:layout_marginTop="@dimen/dp8"
            android:text="@string/recent_transactions"
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/incomeCard" />


        <!-- RecyclerView for listing recent transactions with padding -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expensesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:layout_weight="1"
            android:padding="@dimen/dp8"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/addExpenseButton"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recentTransactionsTitle" />


        <!-- Add Expense Floating Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addExpenseButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp56"
            android:layout_margin="@dimen/dp4"
            android:backgroundTint="@color/primaryColor"
            android:text="@string/add"
            android:textColor="@color/black"
            android:textSize="@dimen/sp20"
            app:cornerRadius="@dimen/dp10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <!-- Navigation View for side navigation, initially hidden -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fitsSystemWindows="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ProgressBar centered with proper constraints -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
